# WorkPilot 配置模板
# 复制为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交，key 不会泄露。

# ============================================================
# API Keys —— 只需填你要用的那家，其余留空即可
# ============================================================

# OpenAI (GPT 系列)
OPENAI_API_KEY=

# Anthropic (Claude 系列) —— 走原生 anthropic SDK
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# 阿里云 DashScope —— Qwen(通义千问) 与 百炼(bailian) 共用
DASHSCOPE_API_KEY=

# 智谱 ChatGLM
GLM_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# 企业自建或其他 OpenAI-compatible 网关
CUSTOM_API_KEY=

# ============================================================
# 运行默认值 —— 可被 CLI 参数覆盖
# ============================================================

# 默认 provider: stub | openai | claude | deepseek | qwen | glm | bailian | gemini | custom
WORKPILOT_PROVIDER=stub

# 默认模型（留空则使用当前 Provider Descriptor；运行 workpilot providers 查看）
# custom 必须显式配置 WORKPILOT_MODEL 与 WORKPILOT_BASE_URL
WORKPILOT_MODEL=

# 自定义 API base_url（一般留空，仅在用代理/私有网关时填）
WORKPILOT_BASE_URL=

# 预算
MAX_STEPS=30
TIME_BUDGET_SECONDS=300
TOKEN_BUDGET=100000

# ============================================================
# 高可用运行状态存储
# ============================================================

# 生产/持久化 Web 服务必须配置 PostgreSQL。不要把真实密码提交到 Git，
# 也不要通过命令行参数传递。配置后先运行：alembic upgrade head
# 示例：postgresql+psycopg://workpilot:password@127.0.0.1:5432/workpilot
WORKPILOT_DATABASE_URL=

# Run 绉熺害锛氬績璺抽棿闅斾笉寰楄秴杩?TTL 鐨勪笁鍒嗕箣涓€
WORKPILOT_LEASE_TTL_SECONDS=30
WORKPILOT_HEARTBEAT_SECONDS=10
